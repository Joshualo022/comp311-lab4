    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>regfile</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>clk RegWrite WriteReg WriteData ReadReg1 ReadReg2 ReadData1 ReadData2
# write x1 = 5
C 1 1 5 1 0 5 0
# writes to x0 are ignored
C 1 0 99 0 1 0 5
# RegWrite = 0 must not write x2
C 0 2 7 2 1 0 5
# write x31 = -1
C 1 31 0xFFFFFFFF 31 1 0xFFFFFFFF 5
# reads change immediately, no clock needed
0 0 0 0 1 31 5 0xFFFFFFFF
# no rising edge -&gt; no write, even with RegWrite = 1
0 1 3 42 3 0 0 0
# write x3 = 42, read same register on both ports
C 1 3 42 3 3 42 42
# overwrite x1; x3 unchanged
C 1 1 0x80000000 1 3 0x80000000 42
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-20" y="500"/>
    </visualElement>
